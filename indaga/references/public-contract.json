{
  "format": "indaga-public-workflows-v1",
  "mcp_url": "https://app.indaga.ai/v1/mcp/public-workflows",
  "operations": {
    "decision.ceiling": {
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "public_contract": {
            "description": "Public workflow compatibility version.",
            "type": "string"
          }
        },
        "required": [
          "public_contract"
        ],
        "type": "object"
      }
    },
    "indaga.describe_context": {
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "public_contract": {
            "description": "Public workflow compatibility version.",
            "type": "string"
          }
        },
        "required": [
          "public_contract"
        ],
        "type": "object"
      }
    },
    "labs.panel_coverage": {
      "input_schema": {
        "additionalProperties": false,
