          "analytes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "public_contract": {
            "description": "Public workflow compatibility version.",
            "type": "string"
          }
        },
        "required": [
          "public_contract"
        ],
        "type": "object"
      }
    },
    "labs.query": {
      "input_schema": {
        "additionalProperties": false,
        "properties": {
