            "type": "string"
          }
        },
        "required": [
          "public_contract"
        ],
        "type": "object"
      }
    },
    "weekly.delta": {
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "public_contract": {
            "description": "Public workflow compatibility version.",
            "type": "string"
          }
        },
        "required": [
          "public_contract"
        ],
        "type": "object"
      }
    }
