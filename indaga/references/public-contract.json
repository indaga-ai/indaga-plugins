  "result_contract": {
    "authority": "EvidenceEnvelope",
    "field": "evidence_envelope"
  },
  "supported_versions": [
    "1.0.0"
  ],
  "version": "1.0.0",
  "workflows": {
    "labs": [
      "labs.query",
      "labs.panel_coverage"
    ],
    "record": [
      "indaga.describe_context"
    ],
    "recovery": [
      "recovery.state",
      "decision.ceiling"
    ],
    "weekly": [
      "weekly.delta"
    ]
